# Variáveis VITE_ são públicas no navegador. Nunca coloque segredos aqui.
# Produção real: https://professor.acoesja.com.br (same-site com a API).
VITE_ACOESJA_API_BASE=https://api.acoesja.com.br/api
# Permanecem vazias até o backend publicar as rotas oficiais.
VITE_ACOESJA_LOGIN_URL=
VITE_ACOESJA_POLICIES_URL=
VITE_ACOESJA_REFRESH_PATH=
# Gate desligado: ativação exige autorização, CORS same-site e provider disponível.
VITE_PROFESSOR_REAL_ENABLED=false
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
